      "id": "34d45ea3-40c1-4a5a-9c6f-986c23191c14",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first()?.json ?? {};\n\n// 1. 失败的原工作流执行编号\nconst executionId = String(\n  payload.execution?.id ?? \"\"\n).trim();\n\n// 2. 原工作流信息\nconst workflowId = String(\n  payload.workflow?.id ?? \"\"\n).trim();\n\nconst workflowName = String(\n  payload.workflow?.name ?? \"\"\n).trim();\n\n// 3. 发生错误的节点\nconst failedNode = String(\n  payload.execution?.lastNodeExecuted ??\n  payload.trigger?.error?.node?.name ??\n  \"unknown\"\n).trim() || \"unknown\";\n\n// 4. 原始错误仅用于分类，不直接写入面向 PM 的状态提示\nconst failureMessage = String(\n  payload.execution?.error?.message ??\n  payload.trigger?.error?.message ??\n  \"Unknown workflow error\"\n).slice(0, 1000);\n\nconst normalizedError = failureMessage.toLowerCase();\nlet failureReason;\n\nif (\n  normalizedError.includes(\"no_positive_insights\") ||\n  normalizedError.includes(\"no positive insights\")\n) {\n  failureReason = \"本批次没有可用于汇总的正向产品洞察，整体正向报告未生成。请检查正向洞察分析与入库结果。\";\n} else if (\n  normalizedError.includes(\"quality_filter_empty_output\") ||\n  normalizedError.includes(\"quality_filter_invalid_result\")\n) {\n  failureReason = \"评论质量筛选未返回有效的分析结果，任务已停止。请检查质量筛选节点的输出。\";\n} else if (\n  normalizedError.includes(\"invalid_response\") ||\n  normalizedError.includes(\"invalid response\") ||\n  normalizedError.includes(\"validation\") ||\n  normalizedError.includes(\"schema\") ||\n  normalizedError.includes(\"json parse\") ||\n  normalizedError.includes(\"校验\") ||\n  normalizedError.includes(\"格式\")\n) {\n  failureReason = \"模型返回内容未通过格式或内容校验，分析未完成。请检查失败节点的执行记录。\";\n} else if (\n  /\\b429\\b|rate limit|quota|insufficient|timeout|timed out|econn|fetch failed|\\b502\\b|\\b503\\b|temporarily unavailable/.test(normalizedError)\n) {\n  failureReason = \"模型服务或网络请求未能正常完成，分析未完成。请检查服务状态与接口调用记录。\";\n} else {\n  failureReason = `分析在“${failedNode}”阶段中断，任务未完成。请查看 n8n 对应执行记录；如问题持续，请联系维护人员。`;\n}\n\n// 5. 统一异常数据格式。原始错误保留在 n8n 执行记录中，不暴露给 PM。\nreturn [\n  {\n    json: {\n      execution_id: executionId,\n      has_execution_id: executionId.length > 0,\n      failed_workflow_id: workflowId,\n      failed_workflow_name: workflowName,\n      failed_node: failedNode,\n      failure_message: failureMessage,\n      failure_reason: failureReason,\n      failed_at: new Date().toISOString(),\n      status_message: failureReason\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
