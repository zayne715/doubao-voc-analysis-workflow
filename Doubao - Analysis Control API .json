    },
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst body = input.body ?? input;\n\nconst source = String(body.source ?? '应用宝').trim();\nconst rawLimit = body.limit;\nconst limit = Number(rawLimit);\n\nlet error = '';\n\nif (source !== '应用宝') {\n  error = '当前仅支持应用宝评论数据源';\n}\n\nif (\n  rawLimit === undefined ||\n  rawLimit === null ||\n  String(rawLimit).trim() === '' ||\n  !Number.isInteger(limit) ||\n  limit < 10 ||\n  limit > 1000\n) {\n  error = '评论数量必须是 10～1000 之间的整数';\n}\n\nif (error) {\n  return [{\n    json: {\n      success: false,\n      status: 'invalid_request',\n      message: error\n    }\n  }];\n}\n\n// 为本次分析生成唯一批次编号\nconst now = new Date();\n\nconst datePart = now\n  .toISOString()\n  .replace(/[-:T.Z]/g, '')\n  .slice(0, 14);\n\nconst analysisRunId =\n  `run_${datePart}_${$execution.id}`;\n\nreturn [{\n  json: {\n    success: true,\n    status: 'request_received',\n    source,\n    limit,\n    analysis_run_id: analysisRunId,\n    message: '请求已通过校验，将尝试启动分析；此响应不代表分析已完成'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
