# Copy this file to .env and set your own DeepSeek API key.
# Never commit .env or paste real credentials into workflow JSON.
DEEPSEEK_API_KEY=replace_with_your_key
CACHE_DB_PATH=/data/cache.sqlite3
CACHE_NAMESPACE=issue-v2

# Optional: change a stage version to invalidate that stage's cache only.
# CACHE_VERSION_QUALITY=v1
# CACHE_VERSION_ISSUE=v2
# CACHE_VERSION_CLUSTERING=v1
# CACHE_VERSION_GLOBAL_CONSOLIDATION=v1
# CACHE_VERSION_PROBLEM_INSIGHT=v1
# CACHE_VERSION_POSITIVE_INSIGHT=v1

# Separate version keys for the batch-based speed-test stages.
CACHE_VERSION_QUALITY_BATCH=v1
CACHE_VERSION_ISSUE_BATCH=v1

# Optional opt-in for per-review cache in the two batch stages.
# Default is 0 (disabled). Set to 1 when ready to deploy and validate.
REVIEW_CACHE_ENABLED=0
